---
source: src/compose/mod.rs
expression: "render(&AppConfig::default(), None)"
---
# Generated by DBDock (https://github.com/Pascold/DBDock).
# Changes made here are overwritten the next time DBDock starts a database.
# Usage without DBDock: docker compose up -d
# Passwords are in plain text on purpose: these are local test databases.

name: "dbdock"
services:
  postgres:
    image: "postgres:17"
    environment:
      POSTGRES_DB: "testdb"
      POSTGRES_USER: "tester"
      POSTGRES_PASSWORD: "tester123"
    ports:
      - "127.0.0.1:5432:5432"
    volumes:
      - type: "volume"
        source: "postgres-data"
        target: "/var/lib/postgresql/data"
      - type: "bind"
        source: "/home/tester/.config/dbdock/init/postgres"
        target: "/docker-entrypoint-initdb.d"
        read_only: true
    healthcheck:
      test:
        - "CMD-SHELL"
        - "pg_isready -h 127.0.0.1 -U \"$$POSTGRES_USER\" -d \"$$POSTGRES_DB\""
      interval: "3s"
      timeout: "10s"
      retries: 40
      start_period: "5s"
  mariadb:
    image: "mariadb:11.4"
    environment:
      MARIADB_DATABASE: "testdb"
      MARIADB_USER: "tester"
      MARIADB_PASSWORD: "tester123"
      MARIADB_ROOT_PASSWORD: "root123"
    ports:
      - "127.0.0.1:3306:3306"
    volumes:
      - type: "volume"
        source: "mariadb-data"
        target: "/var/lib/mysql"
      - type: "bind"
        source: "/home/tester/.config/dbdock/init/mariadb"
        target: "/docker-entrypoint-initdb.d"
        read_only: true
    healthcheck:
      test:
        - "CMD-SHELL"
        - "healthcheck.sh --connect --innodb_initialized"
      interval: "3s"
      timeout: "10s"
      retries: 40
      start_period: "5s"
  mysql:
    image: "mysql:8.4"
    environment:
      MYSQL_DATABASE: "testdb"
      MYSQL_USER: "tester"
      MYSQL_PASSWORD: "tester123"
      MYSQL_ROOT_PASSWORD: "root123"
    ports:
      - "127.0.0.1:3307:3306"
    volumes:
      - type: "volume"
        source: "mysql-data"
        target: "/var/lib/mysql"
      - type: "bind"
        source: "/home/tester/.config/dbdock/init/mysql"
        target: "/docker-entrypoint-initdb.d"
        read_only: true
    healthcheck:
      test:
        - "CMD-SHELL"
        - "mysqladmin ping -h 127.0.0.1 -u root -p\"$$MYSQL_ROOT_PASSWORD\" --silent"
      interval: "3s"
      timeout: "10s"
      retries: 40
      start_period: "5s"
  mssql:
    image: "mcr.microsoft.com/mssql/server:2022-latest"
    platform: "linux/amd64"
    environment:
      ACCEPT_EULA: "Y"
      MSSQL_PID: "Developer"
      MSSQL_SA_PASSWORD: "Test_Passw0rd!"
    ports:
      - "127.0.0.1:1433:1433"
    volumes:
      - type: "volume"
        source: "mssql-data"
        target: "/var/opt/mssql"
    healthcheck:
      test:
        - "CMD-SHELL"
        - "/opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P \"$$MSSQL_SA_PASSWORD\" -C -b -Q \"SELECT 1\" -o /dev/null"
      interval: "5s"
      timeout: "10s"
      retries: 60
      start_period: "15s"
  mssql-init:
    image: "mcr.microsoft.com/mssql/server:2022-latest"
    platform: "linux/amd64"
    environment:
      MSSQL_SA_PASSWORD: "Test_Passw0rd!"
      DBDOCK_DB: "testdb"
      DBDOCK_USER: "tester"
      DBDOCK_PASSWORD: "tester123"
    volumes:
      - type: "bind"
        source: "/home/tester/.config/dbdock/seed"
        target: "/dbdock"
        read_only: true
      - type: "bind"
        source: "/home/tester/.config/dbdock/scripts/mssql"
        target: "/dbdock-scripts"
        read_only: true
    entrypoint:
      - "/bin/bash"
      - "-c"
      - "set -e\nexisted=$$(/opt/mssql-tools18/bin/sqlcmd -S mssql -U sa -P \"$$MSSQL_SA_PASSWORD\" -C -b -f 65001 -h -1 -W -Q \"SET NOCOUNT ON; SELECT COUNT(*) FROM sys.databases WHERE name = N'$$DBDOCK_DB'\" | tr -d '[:space:]')\n/opt/mssql-tools18/bin/sqlcmd -S mssql -U sa -P \"$$MSSQL_SA_PASSWORD\" -C -b -f 65001 -i /dbdock/mssql-init.sql\n/opt/mssql-tools18/bin/sqlcmd -S mssql -U sa -P \"$$MSSQL_SA_PASSWORD\" -C -b -f 65001 -d \"$$DBDOCK_DB\" -i /dbdock/mssql.sql\nif [ \"$$existed\" = 0 ]; then\n  for f in /dbdock-scripts/*.sql; do\n    [ -e \"$$f\" ] || continue\n    echo \"DBDock: running $$f\"\n    /opt/mssql-tools18/bin/sqlcmd -S mssql -U sa -P \"$$MSSQL_SA_PASSWORD\" -C -b -f 65001 -d \"$$DBDOCK_DB\" -i \"$$f\"\n  done\nfi\necho \"DBDock: database $$DBDOCK_DB is ready\"\n"
    depends_on:
      mssql:
        condition: "service_healthy"
    restart: "no"
  firebird:
    image: "firebirdsql/firebird:5"
    entrypoint:
      - "tini"
      - "--"
      - "sh"
      - "-c"
      - "grep -qx 'testdb = /var/lib/firebird/data/testdb.fdb' /opt/firebird/databases.conf || echo 'testdb = /var/lib/firebird/data/testdb.fdb' >> /opt/firebird/databases.conf; exec entrypoint.sh firebird"
    environment:
      FIREBIRD_ROOT_PASSWORD: "masterkey"
      FIREBIRD_USER: "tester"
      FIREBIRD_PASSWORD: "tester123"
      FIREBIRD_DATABASE: "testdb.fdb"
      FIREBIRD_DATABASE_DEFAULT_CHARSET: "UTF8"
      FIREBIRD_CONF_WireCrypt: "Enabled"
    ports:
      - "127.0.0.1:3050:3050"
    volumes:
      - type: "volume"
        source: "firebird-data"
        target: "/var/lib/firebird/data"
      - type: "bind"
        source: "/home/tester/.config/dbdock/init/firebird"
        target: "/docker-entrypoint-initdb.d"
        read_only: true
    healthcheck:
      test:
        - "CMD-SHELL"
        - "echo 'SELECT 1 FROM RDB$$DATABASE;' | /opt/firebird/bin/isql -b -q -user SYSDBA -password \"$$FIREBIRD_ROOT_PASSWORD\" localhost:/var/lib/firebird/data/testdb.fdb"
      interval: "3s"
      timeout: "10s"
      retries: 40
      start_period: "5s"
  sqlite:
    image: "alpine:3"
    environment:
      DBDOCK_DB: "test.db"
    volumes:
      - type: "bind"
        source: "/home/tester/.config/dbdock/sqlite"
        target: "/data"
        read_only: false
      - type: "bind"
        source: "/home/tester/.config/dbdock/scripts/sqlite"
        target: "/dbdock-scripts"
        read_only: true
      - type: "bind"
        source: "/home/tester/.config/dbdock/seed/sqlite.sql"
        target: "/seed/sqlite.sql"
        read_only: true
    entrypoint:
      - "/bin/sh"
      - "-c"
      - "set -e\napk add --no-cache sqlite > /dev/null\ndb=\"/data/$$DBDOCK_DB\"\nif [ -f \"$$db\" ]; then\n  echo \"DBDock: $$db already exists\"\nelse\n  tmp=\"$$db.part\"\n  rm -f \"$$tmp\"\n  sqlite3 -bail \"$$tmp\" < /seed/sqlite.sql\n  for f in /dbdock-scripts/*.sql; do\n    [ -e \"$$f\" ] || continue\n    echo \"DBDock: running $$f\"\n    sqlite3 -bail \"$$tmp\" < \"$$f\"\n  done\n  mv \"$$tmp\" \"$$db\"\n  echo \"DBDock: created $$db\"\nfi\n"
    restart: "no"
volumes:
  postgres-data: {}
  mariadb-data: {}
  mysql-data: {}
  mssql-data: {}
  firebird-data: {}
